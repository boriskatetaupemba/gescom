# ============================================================
#  .gitignore — Dolibarr (gescom) — racine = htdocs
# ============================================================

# NB : conf/conf.php et conf/conf.php.old sont suivis volontairement (dépôt privé).
#      ATTENTION : ils contiennent les identifiants de la base de données.

# --- Données & documents générés par l'application ---
/documents/

# --- Verrous & fichiers d'installation ---
/install.lock
/install/install.lock
/install/install.forced.php

# --- Cache des routes de l'API REST ---
/api/temp/

# --- Artefact local volumineux (sauvegarde, pas du code applicatif) ---
/.well-known.zip

# --- Journaux ---
*.log

# --- Fichiers système / éditeurs ---
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
